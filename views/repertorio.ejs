<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= repertorio.nome %> - Louvor dos Jovens ICO</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen antialiased flex flex-col">
  <!-- Topbar Mobile-first -->
  <nav class="bg-slate-800 border-b border-slate-700 sticky top-0 z-30 px-4 sm:px-6 py-3">
    <div class="max-w-5xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <a href="/" class="text-slate-400 hover:text-white p-1 text-sm font-medium">← Voltar</a>
        <span class="text-slate-600 hidden sm:inline">/</span>
        <div class="min-w-0">
          <h1 class="text-sm sm:text-base font-bold text-white truncate"><%= repertorio.nome %></h1>
          <div class="flex items-center gap-2 mt-0.5">
            <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-slate-700 text-amber-300">
              <%= new Date(repertorio.data + 'T00:00:00').toLocaleDateString('pt-BR') %>
            </span>
            <button type="button" onclick="abrirModalEdicaoRepertorio()" class="text-[11px] text-slate-400 hover:text-amber-300 underline">
              Editar
            </button>
          </div>
        </div>
      </div>
      <div class="flex items-center space-x-2 text-xs sm:text-sm shrink-0">
        <a href="/ministrantes" class="text-slate-400 hover:text-white px-2 py-1">Ministrantes</a>
        <a href="/analytics" class="text-slate-400 hover:text-white px-2 py-1">Analytics</a>
      </div>
    </div>
  </nav>

  <main class="flex-1 max-w-5xl w-full mx-auto p-4 sm:p-6 space-y-6 sm:space-y-8">
    <!-- Adicionar Música -->
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 sm:p-6 shadow-md">
      <h2 class="text-base font-semibold text-white mb-3 sm:mb-4">Adicionar Música ao Repertório</h2>
      
      <!-- Busca YouTube por Link ou Texto -->
      <div class="mb-4">
        <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">
          Buscar no YouTube (Link do vídeo ou Nome da música)
        </label>
        <div class="flex flex-col sm:flex-row gap-2">
          <input type="text" id="ytSearchQuery" placeholder="Ex: https://youtu.be/... ou Me Atraiu" 
            class="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400">
          <button type="button" onclick="searchYoutube()" class="bg-slate-700 hover:bg-slate-600 active:scale-[0.99] text-white font-semibold px-4 py-3 sm:py-2.5 rounded-xl text-sm transition-all">
            Buscar / Puxar Link
          </button>
        </div>
        <div id="ytResults" class="mt-3 space-y-2 hidden max-h-56 overflow-y-auto"></div>
      </div>

      <form action="/repertorios/<%= repertorio.id %>/musicas" method="POST" class="space-y-4 pt-4 border-t border-slate-700">
        <input type="hidden" name="youtube_url" id="formYtId">
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
          <div>
            <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Nome da Canção</label>
            <input type="text" name="titulo" id="formTitulo" required 
              class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400">
          </div>
          <div>
            <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Artista / Banda</label>
            <input type="text" name="artista" id="formArtista" required 
              class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400">
          </div>
          <div>
            <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Ano de Lançamento</label>
            <input type="number" name="ano" id="formAno" placeholder="Ex: 2022" 
              class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400">
          </div>
        </div>

        <!-- Seleção de Ministrantes -->
        <div>
          <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">
            Ministrantes (Selecione quem cantou)
          </label>
          <% if (ministrantes.length === 0) { %>
            <p class="text-xs text-rose-400 py-2">
              Nenhum integrante cadastrado. <a href="/ministrantes" class="underline text-amber-400 font-medium">Cadastre integrantes primeiro</a>.
            </p>
          <% } else { %>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 max-h-40 overflow-y-auto bg-slate-900 p-3 rounded-xl border border-slate-700">
              <% ministrantes.forEach(min => { %>
                <label class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-800 text-xs text-slate-200 cursor-pointer select-none">
                  <input type="checkbox" name="ministrantes_ids" value="<%= min.id %>" class="w-4 h-4 rounded bg-slate-800 border-slate-700 text-amber-500 focus:ring-0">
                  <span class="truncate"><%= min.nome %></span>
                </label>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="flex justify-end pt-1">
          <button type="submit" <%= ministrantes.length === 0 ? 'disabled' : '' %> class="w-full sm:w-auto bg-amber-500 hover:bg-amber-600 disabled:opacity-50 text-slate-950 font-bold py-3 sm:py-2.5 px-6 rounded-xl transition-colors text-sm">
            Salvar Música
          </button>
        </div>
      </form>
    </div>

    <!-- Cards de Músicas -->
    <div>
      <h2 class="text-base font-semibold text-white mb-3">Músicas do Dia (<%= musicas.length %>)</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        <% if (musicas.length === 0) { %>
          <div class="bg-slate-800/60 border border-dashed border-slate-700 rounded-2xl p-8 text-center col-span-full">
            <p class="text-slate-400 text-sm">Nenhuma música adicionada ainda.</p>
          </div>
        <% } %>
        <% musicas.forEach((m, idx) => { %>
          <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 sm:p-5 flex flex-col justify-between shadow-sm">
            <div>
              <div class="flex justify-between items-start gap-2">
                <span class="text-xs font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded">#<%= idx + 1 %></span>
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-700 text-slate-300">
                  <%= m.ano ? m.ano : 'Ano N/I' %>
                </span>
              </div>
              <h3 class="font-bold text-white text-base mt-2.5 line-clamp-1"><%= m.titulo %></h3>
              <p class="text-xs text-slate-400 truncate mt-0.5"><%= m.artista %></p>

              <!-- Ministrantes -->
              <div class="mt-3.5 pt-3 border-t border-slate-700/60">
                <p class="text-[11px] uppercase font-semibold text-slate-400 mb-1.5">Ministrado por:</p>
                <div class="flex flex-wrap gap-1">
                  <% m.ministrantes.forEach(min => { %>
                    <span class="bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs px-2 py-0.5 rounded-md font-medium">
                      <%= min.nome %>
                    </span>
                  <% }) %>
                </div>
              </div>
            </div>

            <div class="mt-4 flex items-center justify-between pt-3 border-t border-slate-700/60 text-xs">
              <div>
                <% if (m.youtube_id) { %>
                  <a href="https://www.youtube.com/watch?v=<%= m.youtube_id %>" target="_blank" class="text-red-400 hover:text-red-300 font-semibold flex items-center gap-1 py-1">
                    ▶ YouTube
                  </a>
                <% } %>
              </div>

              <div class="flex items-center gap-2">
                <button type="button" onclick="abrirModalEdicao('<%= encodeURIComponent(JSON.stringify(m)) %>')" class="text-slate-300 hover:text-white font-medium py-1 px-2 rounded hover:bg-slate-700">
                  Editar
                </button>
                <form action="/musicas/<%= m.id %>/delete" method="POST" onsubmit="return confirm('Excluir esta música?')">
                  <input type="hidden" name="repertorio_id" value="<%= repertorio.id %>">
                  <button type="submit" class="text-rose-400 hover:text-rose-300 font-medium py-1 px-2 rounded hover:bg-rose-500/10">Remover</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </main>

  <!-- Modal Edição de Repertório (Bottom Sheet Mobile) -->
  <div id="modalEditRepertorio" class="fixed inset-0 bg-black/75 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 z-50 hidden">
    <div class="bg-slate-800 border-t sm:border border-slate-700 rounded-t-2xl sm:rounded-2xl p-5 sm:p-6 w-full max-w-md shadow-2xl">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-base font-bold text-white">Editar Repertório</h3>
        <button onclick="fecharModalEdicaoRepertorio()" class="text-slate-400 hover:text-white text-2xl leading-none p-1">&times;</button>
      </div>
      <form action="/repertorios/<%= repertorio.id %>/edit" method="POST" class="space-y-4">
        <input type="hidden" name="redirect_to" value="detalhes">
        <div>
          <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Nome do Culto / Evento</label>
          <input type="text" name="nome" value="<%= repertorio.nome %>" required 
            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400">
        </div>
        <div>
          <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Data</label>
          <input type="date" name="data" value="<%= repertorio.data %>" required 
            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400 text-white">
        </div>
        <div class="flex flex-col-reverse sm:flex-row justify-end gap-2 pt-2">
          <button type="button" onclick="fecharModalEdicaoRepertorio()" class="w-full sm:w-auto px-4 py-3 sm:py-2 bg-slate-700 hover:bg-slate-600 rounded-xl text-sm font-semibold">
            Cancelar
          </button>
          <button type="submit" class="w-full sm:w-auto px-5 py-3 sm:py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-xl text-sm font-bold">
            Salvar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Edição da Música (Bottom Sheet Mobile) -->
  <div id="modalEdicao" class="fixed inset-0 bg-black/75 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 z-50 hidden">
    <div class="bg-slate-800 border-t sm:border border-slate-700 rounded-t-2xl sm:rounded-2xl p-5 sm:p-6 w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-base font-bold text-white">Editar Música</h3>
        <button onclick="fecharModalEdicao()" class="text-slate-400 hover:text-white text-2xl leading-none p-1">&times;</button>
      </div>

      <form id="formEdicao" method="POST" class="space-y-4">
        <input type="hidden" name="repertorio_id" value="<%= repertorio.id %>">
        
        <div>
          <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Nome da Canção</label>
          <input type="text" name="titulo" id="editTitulo" required 
            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Artista</label>
            <input type="text" name="artista" id="editArtista" required 
              class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400">
          </div>
          <div>
            <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Ano</label>
            <input type="number" name="ano" id="editAno" 
              class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400">
          </div>
        </div>

        <div>
          <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Link ou ID do YouTube</label>
          <input type="text" name="youtube_url" id="editYoutubeUrl" placeholder="https://youtu.be/..." 
            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400">
        </div>

        <div>
          <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Ministrantes</label>
          <div class="grid grid-cols-2 gap-2 max-h-36 overflow-y-auto bg-slate-900 p-3 rounded-xl border border-slate-700">
            <% ministrantes.forEach(min => { %>
              <label class="flex items-center gap-2 p-1 text-xs text-slate-300 hover:text-white cursor-pointer select-none">
                <input type="checkbox" name="ministrantes_ids" value="<%= min.id %>" class="edit-min-checkbox w-4 h-4 rounded bg-slate-800 border-slate-700 text-amber-500 focus:ring-0">
                <span class="truncate"><%= min.nome %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="flex flex-col-reverse sm:flex-row justify-end gap-2 pt-2">
          <button type="button" onclick="fecharModalEdicao()" class="w-full sm:w-auto px-4 py-3 sm:py-2 bg-slate-700 hover:bg-slate-600 rounded-xl text-sm font-semibold">
            Cancelar
          </button>
          <button type="submit" class="w-full sm:w-auto px-5 py-3 sm:py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-xl text-sm font-bold">
            Salvar Alterações
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    async function searchYoutube() {
      const q = document.getElementById('ytSearchQuery').value.trim();
      if (!q) return;

      const resultsDiv = document.getElementById('ytResults');
      resultsDiv.innerHTML = '<p class="text-xs text-slate-400 p-2">Buscando...</p>';
      resultsDiv.classList.remove('hidden');

      try {
        const res = await fetch(`/api/youtube-search?q=${encodeURIComponent(q)}`);
        const data = await res.json();

        if (data.error) {
          resultsDiv.innerHTML = `<p class="text-xs text-rose-400 p-2">${data.error}</p>`;
          return;
        }

        if (data.length === 0) {
          resultsDiv.innerHTML = '<p class="text-xs text-slate-400 p-2">Nenhum resultado encontrado.</p>';
          return;
        }

        resultsDiv.innerHTML = data.map(item => `
          <div class="flex items-center justify-between p-2.5 bg-slate-900 rounded-xl border border-slate-700 active:border-amber-400 cursor-pointer text-xs"
               onclick="selectYtVideo('${encodeURIComponent(JSON.stringify(item))}')">
            <div class="flex items-center gap-2.5 overflow-hidden">
              ${item.thumb ? `<img src="${item.thumb}" class="w-12 h-8 object-cover rounded shrink-0">` : ''}
              <div class="truncate">
                <p class="font-medium text-white truncate">${item.titulo}</p>
                <p class="text-slate-400 text-[11px]">${item.canal} • ${item.ano || 'N/I'}</p>
              </div>
            </div>
            <button type="button" class="ml-2 bg-slate-800 text-amber-300 px-2.5 py-1 rounded-lg text-[11px] shrink-0 font-medium">
              Usar
            </button>
          </div>
        `).join('');
      } catch (err) {
        resultsDiv.innerHTML = '<p class="text-xs text-rose-400 p-2">Erro ao consultar a API.</p>';
      }
    }

    function selectYtVideo(encodedItem) {
      const item = JSON.parse(decodeURIComponent(encodedItem));
      document.getElementById('formTitulo').value = item.titulo;
      document.getElementById('formArtista').value = item.canal;
      document.getElementById('formAno').value = item.ano || '';
      document.getElementById('formYtId').value = item.youtube_id;
      document.getElementById('ytResults').classList.add('hidden');
    }

    function abrirModalEdicao(encodedMusica) {
      const m = JSON.parse(decodeURIComponent(encodedMusica));
      document.getElementById('formEdicao').action = `/musicas/${m.id}/edit`;
      document.getElementById('editTitulo').value = m.titulo;
      document.getElementById('editArtista').value = m.artista;
      document.getElementById('editAno').value = m.ano || '';
      document.getElementById('editYoutubeUrl').value = m.youtube_id ? `https://www.youtube.com/watch?v=${m.youtube_id}` : '';

      const currentIds = m.ministrantes.map(x => String(x.id));
      document.querySelectorAll('.edit-min-checkbox').forEach(cb => {
        cb.checked = currentIds.includes(cb.value);
      });

      document.getElementById('modalEdicao').classList.remove('hidden');
    }

    function fecharModalEdicao() {
      document.getElementById('modalEdicao').classList.add('hidden');
    }

    function abrirModalEdicaoRepertorio() {
      document.getElementById('modalEditRepertorio').classList.remove('hidden');
    }

    function fecharModalEdicaoRepertorio() {
      document.getElementById('modalEditRepertorio').classList.add('hidden');
    }
  </script>
</body>
</html>