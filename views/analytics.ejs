<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Analytics - Louvor dos Jovens ICO</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen antialiased flex flex-col">
  <nav class="bg-slate-800 border-b border-slate-700 sticky top-0 z-30 px-4 sm:px-6 py-3.5">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center justify-between w-full sm:w-auto">
        <h1 class="text-xl font-bold tracking-tight text-amber-400">Louvor dos Jovens ICO</h1>
      </div>
      <div class="flex items-center justify-around w-full sm:w-auto space-x-1 sm:space-x-4 border-t sm:border-t-0 border-slate-700/60 pt-2 sm:pt-0 text-sm">
        <a href="/" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white font-medium transition-colors">Repertórios</a>
        <a href="/ministrantes" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white font-medium transition-colors">Ministrantes</a>
        <a href="/analytics" class="px-3 py-1.5 rounded-lg bg-slate-700 text-amber-300 font-semibold transition-colors">Analytics</a>
      </div>
    </div>
  </nav>

  <main class="flex-1 max-w-5xl w-full mx-auto p-4 sm:p-6 space-y-5 sm:space-y-6">
    <!-- Totais -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
      <div class="bg-slate-800 border border-slate-700 p-4 sm:p-5 rounded-2xl">
        <span class="text-xs font-semibold uppercase text-slate-400">Total de Repertórios</span>
        <p class="text-2xl sm:text-3xl font-bold text-white mt-1"><%= totalRepertorios %></p>
      </div>
      <div class="bg-slate-800 border border-slate-700 p-4 sm:p-5 rounded-2xl">
        <span class="text-xs font-semibold uppercase text-slate-400">Total de Músicas</span>
        <p class="text-2xl sm:text-3xl font-bold text-amber-400 mt-1"><%= totalMusicas %></p>
      </div>
      <div class="bg-slate-800 border border-slate-700 p-4 sm:p-5 rounded-2xl">
        <span class="text-xs font-semibold uppercase text-slate-400">Integrantes Cadastrados</span>
        <p class="text-2xl sm:text-3xl font-bold text-white mt-1"><%= totalMinistrantes %></p>
      </div>
    </div>

    <!-- Rankings Principais -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      <!-- 1. Quem mais ministrou -->
      <div class="bg-slate-800 border border-slate-700 p-4 sm:p-6 rounded-2xl shadow-md">
        <h2 class="text-base font-semibold text-white mb-3 sm:mb-4">Quem Mais Ministrou</h2>
        <div class="space-y-2.5">
          <% if (topMinistrantes.length === 0) { %>
            <p class="text-slate-500 text-sm py-2">Sem dados registrados.</p>
          <% } %>
          <% topMinistrantes.forEach((item, i) => { %>
            <div class="flex items-center justify-between text-sm py-2 border-b border-slate-700/60 last:border-0 gap-2">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="w-5 text-center font-bold text-xs text-amber-400 shrink-0"><%= i + 1 %></span>
                <span class="text-slate-200 font-medium truncate"><%= item.ministrante %></span>
              </div>
              <span class="bg-slate-700 text-slate-300 font-semibold px-2 py-0.5 rounded text-xs shrink-0">
                <%= item.total %> <%= item.total === 1 ? 'louvor' : 'louvores' %>
              </span>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- 2. Músicas mais tocadas -->
      <div class="bg-slate-800 border border-slate-700 p-4 sm:p-6 rounded-2xl shadow-md">
        <h2 class="text-base font-semibold text-white mb-3 sm:mb-4">Músicas Mais Tocadas</h2>
        <div class="space-y-2.5">
          <% if (topMusicas.length === 0) { %>
            <p class="text-slate-500 text-sm py-2">Sem dados registrados.</p>
          <% } %>
          <% topMusicas.forEach((m, i) => { %>
            <div class="flex items-center justify-between text-sm py-2 border-b border-slate-700/60 last:border-0 gap-2">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="w-5 text-center font-bold text-xs text-amber-400 shrink-0"><%= i + 1 %></span>
                <div class="truncate">
                  <p class="text-slate-200 font-medium truncate"><%= m.titulo %></p>
                  <p class="text-xs text-slate-400 truncate"><%= m.artista %></p>
                </div>
              </div>
              <span class="bg-slate-700 text-slate-300 font-semibold px-2 py-0.5 rounded text-xs shrink-0">
                <%= m.total %>x
              </span>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- 3. Artistas Mais Tocados -->
      <div class="bg-slate-800 border border-slate-700 p-4 sm:p-6 rounded-2xl shadow-md">
        <h2 class="text-base font-semibold text-white mb-3 sm:mb-4">Artistas Mais Tocados</h2>
        <div class="space-y-2.5">
          <% if (topArtistas.length === 0) { %>
            <p class="text-slate-500 text-sm py-2">Sem dados registrados.</p>
          <% } %>
          <% topArtistas.forEach((a, i) => { %>
            <div class="flex items-center justify-between text-sm py-2 border-b border-slate-700/60 last:border-0 gap-2">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="w-5 text-center font-bold text-xs text-amber-400 shrink-0"><%= i + 1 %></span>
                <p class="text-slate-200 font-medium truncate"><%= a.artista %></p>
              </div>
              <span class="bg-slate-700 text-slate-300 font-semibold px-2 py-0.5 rounded text-xs shrink-0">
                <%= a.total %> <%= a.total === 1 ? 'música' : 'músicas' %>
              </span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Décadas mais presentes -->
    <div class="bg-slate-800 border border-slate-700 p-4 sm:p-6 rounded-2xl shadow-md">
      <h2 class="text-base font-semibold text-white mb-3 sm:mb-4">Distribuição por Décadas</h2>
      <% if (decadas.length === 0) { %>
        <p class="text-slate-500 text-sm">Sem anos catalogados nas canções.</p>
      <% } else { %>
        <div class="space-y-3">
          <% decadas.forEach(d => { 
             const perc = totalMusicas ? Math.round((d.total / totalMusicas) * 100) : 0;
          %>
            <div>
              <div class="flex justify-between text-xs font-semibold text-slate-300 mb-1">
                <span>Anos <%= d.decada %></span>
                <span><%= d.total %> canções (<%= perc %>%)</span>
              </div>
              <div class="w-full bg-slate-700 rounded-full h-2.5 overflow-hidden">
                <div class="bg-amber-400 h-2.5 rounded-full transition-all" style="width: <%= perc %>%;"></div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>