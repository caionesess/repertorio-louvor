<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Louvor dos Jovens ICO - Repertórios</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/favicon.png">
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen antialiased flex flex-col">
  <!-- Navbar Responsiva -->
<nav class="bg-slate-800 border-b border-slate-700 sticky top-0 z-30 px-4 sm:px-6 py-3.5">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center justify-between w-full sm:w-auto">
        <h1 class="text-xl font-bold tracking-tight text-amber-400">Louvor Jovens</h1>
      </div>
      <div class="flex items-center justify-around w-full sm:w-auto space-x-1 sm:space-x-3 border-t sm:border-t-0 border-slate-700/60 pt-2 sm:pt-0 text-xs sm:text-sm">
        <a href="/" class="px-3 py-1.5 rounded-lg bg-slate-700 text-amber-300 font-semibold transition-colors">Repertórios</a>
        <a href="/acervo" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white font-medium transition-colors">Acervo</a>
        <a href="/ministrantes" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white font-medium transition-colors">Ministrantes</a>
        <a href="/analytics" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white font-medium transition-colors">Analytics</a>
      </div>
    </div>
  </nav>

  <main class="flex-1 max-w-5xl w-full mx-auto p-4 sm:p-6 space-y-6 sm:space-y-8">
    <!-- Bloco Novo Repertório -->
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 sm:p-6 shadow-md">
      <h2 class="text-base sm:text-lg font-semibold text-white mb-3 sm:mb-4">Novo Repertório</h2>
      <form action="/repertorios" method="POST" class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
        <div>
          <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Nome do Culto / Evento</label>
          <input type="text" name="nome" placeholder="Ex: Culto Jovens - Conexão" required 
            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Data</label>
          <input type="date" name="data" required 
            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400 transition-colors text-white">
        </div>
        <div class="flex items-end">
          <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 active:scale-[0.99] text-slate-950 font-bold py-3 sm:py-2.5 px-4 rounded-xl text-sm transition-all shadow-sm">
            + Criar Repertório
          </button>
        </div>
      </form>
    </div>

    <!-- Lista de Repertórios -->
    <div>
      <h2 class="text-base sm:text-lg font-semibold text-white mb-3 sm:mb-4">Repertórios Criados</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4">
        <% if (repertorios.length === 0) { %>
          <div class="bg-slate-800/60 border border-dashed border-slate-700 rounded-2xl p-8 text-center col-span-full">
            <p class="text-slate-400 text-sm">Nenhum repertório criado ainda.</p>
          </div>
        <% } %>
        <% repertorios.forEach(r => { %>
          <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 sm:p-5 flex flex-col justify-between shadow-sm hover:border-slate-600 transition-colors">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-slate-700 text-amber-300">
                  <%= new Date(r.data + 'T00:00:00').toLocaleDateString('pt-BR') %>
                </span>
                <button type="button" onclick="abrirModalEdicaoRepertorio('<%= r.id %>', '<%= r.nome %>', '<%= r.data %>')" class="text-xs text-slate-400 hover:text-white p-1 font-medium">
                  Editar
                </button>
              </div>
              <h3 class="text-base sm:text-lg font-bold text-white mt-3 leading-snug"><%= r.nome %></h3>
              <p class="text-xs sm:text-sm text-slate-400 mt-1"><%= r.total_musicas %> <%= r.total_musicas === 1 ? 'música' : 'músicas' %> cadastradas</p>
            </div>
            <div class="mt-5 flex items-center justify-between pt-3.5 border-t border-slate-700/60">
              <a href="/repertorios/<%= r.id %>" class="text-sm text-amber-400 hover:text-amber-300 font-semibold py-1">
                Abrir Repertório →
              </a>
              <form action="/repertorios/<%= r.id %>/delete" method="POST" onsubmit="return confirm('Deseja excluir este repertório e todas as músicas dele?')">
                <button type="submit" class="text-xs text-rose-400 hover:text-rose-300 font-medium py-1 px-2">Excluir</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </main>

  <!-- Modal Responsivo (Bottom Sheet no Mobile) -->
  <div id="modalEditRepertorio" class="fixed inset-0 bg-black/75 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 z-50 hidden">
    <div class="bg-slate-800 border-t sm:border border-slate-700 rounded-t-2xl sm:rounded-2xl p-5 sm:p-6 w-full max-w-md shadow-2xl">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-base font-bold text-white">Editar Repertório</h3>
        <button onclick="fecharModalEdicaoRepertorio()" class="text-slate-400 hover:text-white text-2xl leading-none p-1">&times;</button>
      </div>
      <form id="formEditRepertorio" method="POST" class="space-y-4">
        <input type="hidden" name="redirect_to" value="index">
        <div>
          <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Nome do Culto / Evento</label>
          <input type="text" name="nome" id="editRepertorioNome" required 
            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400">
        </div>
        <div>
          <label class="block text-xs uppercase font-semibold text-slate-400 mb-1">Data</label>
          <input type="date" name="data" id="editRepertorioData" required 
            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-base sm:text-sm focus:outline-none focus:border-amber-400 text-white">
        </div>
        <div class="flex flex-col-reverse sm:flex-row justify-end gap-2 pt-2">
          <button type="button" onclick="fecharModalEdicaoRepertorio()" class="w-full sm:w-auto px-4 py-3 sm:py-2.5 bg-slate-700 hover:bg-slate-600 rounded-xl text-sm font-semibold">
            Cancelar
          </button>
          <button type="submit" class="w-full sm:w-auto px-5 py-3 sm:py-2.5 bg-amber-500 hover:bg-amber-600 text-slate-950 rounded-xl text-sm font-bold">
            Salvar Alterações
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function abrirModalEdicaoRepertorio(id, nome, data) {
      document.getElementById('formEditRepertorio').action = `/repertorios/${id}/edit`;
      document.getElementById('editRepertorioNome').value = nome;
      document.getElementById('editRepertorioData').value = data;
      document.getElementById('modalEditRepertorio').classList.remove('hidden');
    }
    function fecharModalEdicaoRepertorio() {
      document.getElementById('modalEditRepertorio').classList.add('hidden');
    }
  </script>
</body>
</html>